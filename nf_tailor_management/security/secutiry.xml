<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_nf_tailor_management_category" model="ir.module.category">
            <field name="name">Tailor Management</field>
            <field name="description">User groups for Tailor Management System</field>
            <field name="sequence">100</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_tailor">
            <field name="name">Tailor Management</field>
            <field name="category_id" ref="module_nf_tailor_management_category"/>
            <field name="sequence">100</field>
        </record>

        <record id="nf_group_nf_tailor_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_tailor"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="nf_group_nf_tailor_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_tailor"/>
            <field name="implied_ids" eval="[(4, ref('nf_group_nf_tailor_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>