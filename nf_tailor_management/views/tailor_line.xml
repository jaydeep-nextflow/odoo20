<?xml version="1.0" encoding="UTF-8"?>
<!-- nf_tailor/views/tailor_line_views.xml -->
<odoo>
    <!-- Form View -->
    <record id="view_nf_tailor_line_form" model="ir.ui.view">
        <field name="name">nf.tailor.line.form</field>
        <field name="model">nf.tailor.line</field>
        <field name="arch" type="xml">
            <form string="Tailor Line">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="order_id" />
                        <field name="quantity" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_nf_tailor_line_tree" model="ir.ui.view">
        <field name="name">nf.tailor.line.tree</field>
        <field name="model">nf.tailor.line</field>
        <field name="arch" type="xml">
            <list string="Tailor Lines">
                <field name="name" />
                <field name="order_id" />
                <field name="quantity" />
            </list>
        </field>
    </record>

    <!-- Action to open tailor lines -->
    <record id="action_nf_tailor_line" model="ir.actions.act_window">
        <field name="name">Tailor Lines</field>
        <field name="res_model">nf.tailor.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>