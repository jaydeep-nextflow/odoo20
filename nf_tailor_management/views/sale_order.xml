<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="nf_tailor_sale_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.nf.tailor</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <field name="tailor_order_id" invisible='1' />
                    <page name="nf_measurement" string="Measurements" invisible="not tailor_order_id">
                        <field name="measurement_line_ids" >
                            <list>
                                <field name="measurement_type_id"></field>
                                <field name="size"></field>
                                <field name="note"></field>
                            </list>
                        </field>
                    </page>
                    <page name="nf_measurement_design" string="Designs" invisible="not tailor_order_id">
                        <field name="design_ids" >
                            <list>
                                <field name="design_type"></field>
                                <field name="design_image" domain="[('design_id', '=', design_type)]"></field>
                                <field name="image_1920" widget="image" class="oe_avatar" />
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

         <record id="nf_tailor_mrp_production_form_inherit" model="ir.ui.view">
            <field name="name">mrp.production.form.inherit.nf.tailor</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <field name="tailor_order_id" invisible='1' />
                    <page name="nf_measurement" string="Measurements" invisible="not tailor_order_id">
                        <field name="measurement_line_ids" >
                            <list>
                                <field name="measurement_type_id"></field>
                                <field name="size"></field>
                                <field name="note"></field>
                            </list>
                        </field>
                    </page>
                    <page name="nf_measurement_design" string="Designs" invisible="not tailor_order_id">
                        <field name="design_ids" >
                            <list>
                                <field name="design_type"></field>
                                <field name="design_image" domain="[('design_id', '=', design_type)]"></field>
                                <field name="image_1920" widget="image" class="oe_avatar" />
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
