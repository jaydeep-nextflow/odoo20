<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_measurement_tree" model="ir.ui.view">
        <field name="name">measurement.tree</field>
        <field name="model">nf.measurement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="uom_id" />
            </list>
        </field>
    </record>

    <record id="nf_measurement_search_view" model="ir.ui.view">
        <field name="name">measurement.search</field>
        <field name="model">nf.measurement</field>
        <field name="arch" type="xml">
            <search string="Search Measurement">
                <field name="name" string="Name" filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'child_of', self)]"/>
                <field name="partner_id" operator="child_of"/>
                <filter string="Male" domain="[('gender', '=', 'male')]" name="gender"/>
                <filter string="Female" domain="[('gender', '=', 'female')]" name="gender"/>
                <filter string="Other" domain="[('gender', '=', 'other')]" name="gender"/>
            </search>
        </field>
    </record>

    <record id="view_measurement_form" model="ir.ui.view">
        <field name="name">measurement.form</field>
        <field name="model">nf.measurement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" class="oe_inline" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1" />
                            <field name="gender" widget="radio" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="uom_id" required='1' />
                            <field name="measurement_categ_id" domain="[('gender', 'in', [gender, 'other'])]"></field>
                        </group>
                    </group>
                    <notebook>
                        <page name="Measurement lines" string="Measurement Information">
                            <field name="measurement_line_ids" editable="bottom">
                                <list editable="bottom">
                                    <field name="measurement_type_id" ></field>
                                    <field name="size"></field>
                                    <field name="note"></field>
                                </list>
                            </field>
                        </page>
                        <page name="design" string="Designs">
                            <field name="measurement_design_ids" editable="bottom">
                                <list editable="bottom">
                                    <field name="design_type" ></field>
                                    <field name="design_image"
                                        domain="[('design_id', '=', design_type)]"></field>
                                    <field name="image_1920" widget="image" class="oe_avatar" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>