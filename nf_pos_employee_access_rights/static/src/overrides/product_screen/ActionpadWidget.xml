<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="nf_pos_employee_access_rights.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('pay-order-button')]" position="attributes">
            <attribute name="t-if">this.pos.getCashier() and !this.pos.getCashier().nf_hide_payment_button</attribute>
        </xpath>
    </t>
    <t t-name="nf_pos_employee_access_rights.SelectPartnerButton" t-inherit="point_of_sale.SelectPartnerButton" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('set-partner')]" position="attributes">
            <attribute name="t-attf-class">{{this.pos.getCashier() and !this.pos.getCashier().nf_hide_customer_button ? '' : 'd-none'}}</attribute>
        </xpath>
    </t>

</templates>