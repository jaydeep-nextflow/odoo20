<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="nf_pos_employee_access_rights.PaymentScreenMethods" t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethod')]" position="attributes">
            <attribute name="t-if">this.pos.getCashier() and !this.pos.getCashier().nf_restrict_payment_method or (this.pos.getCashier().nf_restrict_payment_method and this.pos.getCashier()?.nf_pos_payment_methods.map((x) => x.id).includes(paymentMethod.id))  </attribute>
        </xpath>
    </t>
    
    <t t-name="nf_pos_employee_access_rights.PaymentScreenValidate" t-inherit="point_of_sale.PaymentScreenValidate" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('validation-button')]" position="attributes">
            <attribute name="t-if" separator="" add="this.pos.getCashier() and !this.pos.getCashier().nf_hide_payment_validate_button" ></attribute>
        </xpath>
    </t>


<!-- <t t-name="nf_pos_employee_access_rights.pos_stock_PaymentScreenButtons" t-inherit="pos_stock.PaymentScreenButtons" t-inherit-mode="extension">
    </t> -->
    <t t-name="nf_pos_employee_access_rights.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='this.toggleShippingDatePicker']" position="attributes">
            <attribute name="t-if" separator=" AND " >this.pos.config.ship_later
            and this.pos.getCashier()
            and !this.pos.getCashier().nf_hide_payment_ship_later_button</attribute>
        </xpath>
        <xpath expr="//button[@t-if='this.pos.config.iface_tipproduct and this.pos.config.tip_product_id']" position="attributes">
            <attribute name="t-if" separator=" and " add="this.pos.getCashier() and !this.pos.getCashier().nf_hide_payment_tip_button" ></attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='this.toggleIsToInvoice']" position="attributes">
            <attribute name="t-if" separator=" and " add="this.pos.getCashier() and !this.pos.getCashier().nf_hide_payment_invoice_button" ></attribute>
        </xpath>
        <xpath expr="//button[hasclass('partner-button')]" position="attributes">
            <attribute name="t-attf-class" separator=" and " add="{{this.pos.getCashier() and !this.pos.getCashier().nf_hide_customer_button ? '':'d-none'}}" ></attribute>
        </xpath>
    </t>

</templates>