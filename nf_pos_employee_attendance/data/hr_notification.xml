<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- Break Reminder Cron (runs every 5 mins) -->
    <record id="ir_cron_break_reminder" model="ir.cron">
      <field name="name">Employee Break Reminder</field>
      <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
      <field name="state">code</field>
      <field name="code">model.nf_cron_send_break_reminders()</field>
      <field name="interval_number">5</field>
      <field name="interval_type">minutes</field>
      <field name="active" eval="True"/>
    </record>

    <!-- Shift End Reminder Cron (runs every 5 mins) -->
    <record id="ir_cron_shift_end_reminder" model="ir.cron">
      <field name="name">Employee Shift End Reminder</field>
      <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
      <field name="state">code</field>
      <field name="code">model.nf_cron_send_shift_end_reminders()</field>
      <field name="interval_number">5</field>
      <field name="interval_type">minutes</field>
      <field name="active" eval="True"/>
    </record>

  </data>
</odoo>
