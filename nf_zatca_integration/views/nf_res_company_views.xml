<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_company_form" model="ir.ui.view">
            <field name="name">res.company.form.nf</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='country_id']" position="after">
                    <field name="nf_zatca_building_number" placeholder="Building Number"
                           invisible="country_code != 'SA'"
                           class="o_address_building_number" options='{"no_open": True, "no_create": True}'/>
                    <field name="nf_zatca_plot_identification" placeholder="Plot Identification"
                           invisible="country_code != 'SA'"
                           class="o_address_plot_identification" options='{"no_open": True, "no_create": True}'/>
                </xpath>
                <xpath expr="//field[@name='vat']" position="before">
                    <field name="nf_zatca_additional_identification_scheme" invisible="country_code != 'SA'"/>
                    <field name="nf_zatca_additional_identification_number" invisible="country_code != 'SA' or nf_zatca_additional_identification_scheme == 'TIN'"/>
                </xpath>

                <field name="name" position="after">
                    <field name="arabic_name" placeholder="e.g. شركتي" invisible="country_code != 'SA'"/>
                </field>
                <field name="vat" position="before">
                    <field name="arabic_city" placeholder="e.g. مدينة" invisible="country_code != 'SA'"/>
                </field>
                <page name="branches" position="after">
                    <page name="zatca" string="ZATCA" invisible="country_code != 'SA'">
                        <group>
                            <group>
                                <field name="nf_zatca_api_mode" string="API Mode"/>
                                <field name="nf_zatca_private_key_id" readonly="1" invisible="1"/>
                            </group>
                        </group>
                        <field name="journal_ids" nolabel="1">
                            <list create="0" delete="0" decoration-success="nf_zatca_compliance_checks_passed"
                                  decoration-danger="nf_zatca_csr_errors">
                                <field name="name"/>
                                <field name="nf_zatca_serial_number" readonly="1" groups="base.group_no_one"/>
                                <field name="nf_zatca_compliance_csid_json"
                                       string="Request for CCSID" column_invisible="1"/>
                                <field name="nf_zatca_compliance_checks_passed"
                                       string="Compliance Checks" column_invisible="1"/>
                                <field name="nf_zatca_production_csid_json"
                                       string="Request for PCSID" column_invisible="1"/>

                                <button name="%(zatca_otp_wizard_act_window)d" type="action" icon="fa-key"
                                        invisible="nf_zatca_csr_errors or nf_zatca_compliance_csid_json"
                                        class="btn-info" string="Onboard Journal"/>
                                <button name="%(zatca_otp_wizard_act_window)d" type="action" icon="fa-key"
                                        invisible="not nf_zatca_csr_errors or nf_zatca_compliance_csid_json or nf_zatca_production_csid_json"
                                        class="btn-danger" string="Onboard Journal"/>

                                <button name="%(zatca_otp_wizard_act_window)d" type="action" icon="fa-refresh"
                                        class="btn-info" context="{'default_nf_zatca_renewal': True}"
                                        invisible="not nf_zatca_compliance_checks_passed or not nf_zatca_production_csid_json"
                                        string="Renew Production CSID"/>
                                <button name="%(zatca_otp_wizard_act_window)d" type="action" icon="fa-refresh" class="btn-warning ms-2"
                                        confirm="Are you sure you wish to re-onboard the Journal?"
                                        invisible="not nf_zatca_compliance_checks_passed or not nf_zatca_production_csid_json"
                                        string="Re-Onboard"/>
                            </list>
                        </field>
                    </page>
                </page>

            </field>
        </record>
    </data>
</odoo>
