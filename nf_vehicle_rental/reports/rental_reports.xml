<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="rental_order_report_template">
        <t t-call="web.external_layout">
            <t t-set="record" t-value="record.with_context(lang=record.partner_id.lang)" />
            <div class="page" style="page-break-inside: avoid;">
                <div class="text-right address">
                    <div t-field="record.partner_id"
                        t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
                    <p t-if="record.partner_id.vat">
                    <t t-if="record.company_id.account_fiscal_country_id.vat_label"
                        t-out="record.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="record.partner_id.vat"/>
                    </p>
                </div>
                <div class="mt-3">
                    <h1 t-field="record.name"></h1>
                </div>
                <div class="row mb-4">
                    <div class="col">
                        <strong>Start Date </strong>
                            <div t-field="record.start_date" t-options="{'widget': 'datetime', 'tz_name': record.env.user.tz}"></div>
                    </div>
                    <div class="col">
                        <strong>End Date</strong>
                        <div t-field="record.end_date" t-options="{'widget': 'datetime', 'tz_name': record.env.user.tz}"></div>
                    </div>
                    <div class="col">
                        <strong>Duration</strong>
                        <div t-field="record.duration"></div>
                    </div>
                    <div class="col">
                        <strong>Rent Type</strong>
                        <div t-field="record.rent_type"></div>
                    </div>
                </div>
                    <div>
                        <table class="o_has_total_table table o_main_table table-borderless">
                            <thead style="display: table-row-group">
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end text-nowrap">Duration</th>
                                    <th class="text-end text-nowrap">Rate</th>
                                    <th class="text-end text-nowrap">Taxes</th>
                                    <th class="text-end text-nowrap">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="text_tbody">
                                <t t-foreach="record.rent_line_ids" t-as="line">
                                    <tr t-att-class="'fw-bold'">
                                        <td class="text-start">
                                            <span t-field="line.vehicle_id"></span>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.duration_value"></span>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.rate"></span>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.taxes_id"></span>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.subtotal" t-options='{"widget": "monetary", "display_currency": line.currency_id}'></span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="clearfix">
                    <div class="row mt-n3">
                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                            <table class="o_total_table table table-borderless">
                                <tbody>
                                    <tr>
                                        <td>
                                            <strong>Untaxed Amount</strong><br/>
                                            <strong t-if="record.total_tax">Tax</strong>
                                        </td>
                                        <td class="text-end">
                                            <span  t-field="record.amount_untaxed" t-options='{"widget": "monetary", "display_currency": record.currency_id}'></span><br/>
                                            <span t-if="record.total_tax" t-field="record.total_tax" t-options='{"widget": "monetary", "display_currency": record.currency_id}'></span>
                                        </td>
                                    </tr>
                                    <tr class="border-top">
                                        <td>
                                            <strong>Total</strong><br/><br />
                                            <strong>Amount Deposit</strong><br/>
                                            <strong t-if="record.amount_residual">Amount Due</strong>
                                        </td>
                                        <td class="text-end"> 
                                            <span t-field="record.amount_total" t-options='{"widget": "monetary", "display_currency": record.currency_id}'></span><br/><br/>
                                            <span t-field="record.deposit_amount" t-options='{"widget": "monetary", "display_currency": record.currency_id}'></span><br/>
                                            <span t-if="record.amount_residual" t-field="record.amount_residual" t-options='{"widget": "monetary", "display_currency": record.currency_id}'></span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="rental_order_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="record">
                <t t-call="nf_vehicle_rental.rental_order_report_template" t-lang="record.partner_id.lang" />
            </t>
        </t>
    </template>

    <template id="nf_report_saleorder">
        <t t-call="nf_vehicle_rental.rental_order_report"/>
    </template>

    <record id="action_rental_report" model="ir.actions.report">
        <field name="name">Rental Order</field>
        <field name="model">fleet.rent</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nf_vehicle_rental.nf_report_saleorder</field>
        <!-- <field name="report_file">nf_vehicle_rental.nf_report_saleorder</field> -->
        <field name="print_report_name">'Rent Order %s' % (object.name)</field>
        <field name="binding_model_id" ref="nf_vehicle_rental.model_fleet_rent" />
        <field name="binding_type">report</field>
    </record>

</odoo>