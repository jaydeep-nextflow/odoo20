<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="fleet_rental_location_tree_view" model="ir.ui.view">
        <field name="name">Fleet Rental Location List</field>
        <field name="model">rental.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="address"/>
                <field name="company_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="active" widget="boolean_toggle" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="fleet_rental_location_form_view" model="ir.ui.view">
        <field name="name">Fleet Rental Location Form</field>
        <field name="model">rental.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="address"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id"/>
                            <field name="active" widget="boolean_toggle" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
        <!-- search view -->
     <record id="appointment_type_search" model="ir.ui.view">
        <field name="name">Rental Location Search</field>
        <field name="model">rental.location</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="active"/>
                <!-- Filter  -->
                <filter string="Archived" name="active_user" domain="[('active', '!=', 'true')]"/>
                 
            </search>
        </field>
     </record>

    <record id="action_fleet_rental_location_window_view" model="ir.actions.act_window">
        <field name="name">Rental Location</field>
        <field name="res_model">rental.location</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>