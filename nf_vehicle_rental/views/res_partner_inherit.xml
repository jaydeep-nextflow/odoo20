<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="fleet_res_partner_form_view" model="ir.ui.view">
        <field name="name">fleet Res Partner Form inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="birth_date"/>
                <field name="license_no"/>
                <field name="id_proof_name" invisible="1"/>
                <field name="id_proof_attachment" widget="binary" filename="id_proof_name"/>
            </xpath>
        </field>
    </record>
</odoo>