<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="fleet_rent_line_tree_view" model="ir.ui.view">
        <field name="name">Fleet Rent Line List</field>
        <field name="model">fleet.rent.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="contract_id"/>
                <field name="partner_id" />
                <field name="vehicle_id" widget="many2one_avatar_user"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="duration_value"/>
                <field name="rate" widget="monetary"/>
                <field name="taxes_id" widget="many2many_tags"/>
                <field name="tax_total" widget="monetary" optional="hide"/>
                <field name="subtotal" widget="monetary"/>
                <field name="total_amount" widget="monetary" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="fleet_rent_line_search_view" model="ir.ui.view">
        <field name="name">Fleet Rent Line Search</field>
        <field name="model">fleet.rent.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="contract_id"/>
                <field name="vehicle_id"/>
                <field name="partner_id"/>
                <group>
                    <filter name="partner_id" context="{'group_by' : 'partner_id'}" string="Customer"></filter>
                    <filter name="vehicle_id" context="{'group_by' : 'vehicle_id'}" string="Vehicle"></filter>
                    <filter name="contract_id" context="{'group_by' : 'contract_id'}" string="Rent"></filter>
                </group>
            </search>
        </field>
    </record>

    <record id="fleet_rent_line_form_view" model="ir.ui.view">
        <field name="name">Fleet Rent Line Form</field>
        <field name="model">fleet.rent.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="partner_id" />
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="rate"/>
                            <field name="duration_value"/>
                        </group>
                        <group>
                            <field name="vehicle_id" widget="many2one_avatar_user"/>
                            <field name="taxes_id" widget="many2many_tags"/>
                            <field name="tax_total" widget="monetary"/>
                            <field name="subtotal" widget="monetary"/>
                            <field name="total_amount" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_rent_line_window_view" model="ir.actions.act_window">
        <field name="name">Rental Lines</field>
        <field name="res_model">fleet.rent.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>