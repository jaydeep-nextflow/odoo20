<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nf_receipt_template_list" model="ir.ui.view">
        <field name="name">nf.receipt.template.list</field>
        <field name="model">nf.receipt.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="nf_receipt_name"/>
                <field name="nf_receipt_xml" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_nf_receipt_template_form" model="ir.ui.view">
        <field name="name">nf.receipt.template.form</field>
        <field name="model">nf.receipt.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="nf_receipt_name"/>
                        </group>
                        <group>
                            <field name="nf_receipt_xml"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nf_pos_receipt_template" model="ir.actions.act_window">
        <field name="name">Receipt Designs</field>
        <field name="res_model">nf.receipt.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_nf_pos_receipt_template"
        name="Receipt Designs"
        parent="point_of_sale.menu_point_config_product"
        action="action_nf_pos_receipt_template" sequence="41"/>
</odoo>