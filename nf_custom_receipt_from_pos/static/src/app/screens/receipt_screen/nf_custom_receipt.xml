<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <t t-name="nf_custom_receipt_from_pos.NfCustomReceipt">
        <t t-if="DynamicReceiptComponent">
            <t t-component="DynamicReceiptComponent" data="props.data" order="props.order" />
        </t>
        <t t-else="">
            <div class="pos-receipt">
                <div style="color: red; text-align: center; font-weight: bold;">
                    Custom Receipt Template Error or Not Found.
                </div>
            </div>
        </t>
    </t>

    <t t-name="nf_custom_receipt_from_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
            <attribute name="t-if">!props.order.config.nf_custom_receipt_template or !props.order.config.nf_receipt_template_id</attribute>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt')]" position="before">
            <t t-if="props.order.config.nf_custom_receipt_template and props.order.config.nf_receipt_template_id">
            <t t-log="'xml',props.basic_receipt"></t>
                <NfCustomReceipt data="props.data" order="props.order" basic_receipt="props.basic_receipt"/>
            </t>
        </xpath>
    </t>

</templates>
