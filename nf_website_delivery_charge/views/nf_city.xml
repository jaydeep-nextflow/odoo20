<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nf_cities_tree" model="ir.ui.view">
        <field name="name">nf.cities.tree</field>
        <field name="model">nf.cities</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <!-- <field name="state_id"/> -->
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <record id="view_nf_cities_form" model="ir.ui.view">
        <field name="name">nf.cities.form</field>
        <field name="model">nf.cities</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <!-- <field name="state_id"/> -->
                        <field name="country_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
   
    <record id="action_nf_cities" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">nf.cities</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_nf_cities_root" name="Cities" sequence="10"/>
    <menuitem id="menu_nf_cities" name="Manage Cities" parent="website.menu_website_global_configuration" action="action_nf_cities"/>

</odoo>
