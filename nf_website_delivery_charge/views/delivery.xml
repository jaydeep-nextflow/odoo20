        <field name="model">delivery.price.rule</field>
        <field name="inherit_id" ref="delivery.view_delivery_price_rule_form"/>
        <field name="arch" type="xml">
            <field name="max_value" position="attributes" >
                <attribute name="invisible"> variable == 'city' </attribute>
            </field>
            <field name="max_value" position="after" >
                <field name="nf_city_id" />
            </field>
        </field>
    </record>

</odoo>