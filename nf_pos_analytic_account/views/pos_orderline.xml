<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_view_pos_order_line" model="ir.ui.view">
        <field name="name">pos.order.line.list</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" ></field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='products']//field[@name='lines']/list/field[@name='product_id']" position="after" >
                <field name="nf_analytic_account_id"></field>
            </xpath>

            <field name="date_order" position="after">
                <field name="nf_analytic_account_id" invisible="not nf_analytic_account_id"></field>
            </field>
        </field>
    </record>
</odoo>