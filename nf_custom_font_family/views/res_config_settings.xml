<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="nf_font_family_config_view" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <div class="app_settings_block" data-string="Google Font Family" string="Google Font Family" data-key="google_font_family">
                        <div class="o_setting_box">
                            <block title="Google Fonts" name="nf_google_font_family">
                                <setting id="nf_font_family_block">
                                    <div class="content-group">
                                        <field name="nf_is_custom_font"></field>
                                        <label for="nf_is_custom_font" string="Is Google Font"/>
                                    </div>
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <field name="nf_font_family" invisible="nf_is_custom_font != True" required="nf_is_custom_font == True"></field>
                                            <field name="nf_text" invisible="nf_font_family != 'custom' or nf_is_custom_font != True" required="nf_font_family == 'custom'"></field>
                                        </div>
                                    </div>
                                </setting>
                            </block>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
