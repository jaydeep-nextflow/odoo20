<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_form_inherit_no_create_lines" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.no.create.lines</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="attributes">
                <attribute name="groups">nf_restrict_create_product_from_so_po.restrict_to_create_sale_order_group</attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="groups">nf_restrict_create_product_from_so_po.restrict_to_create_sale_order_group</attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="product_template_id" groups="!nf_restrict_create_product_from_so_po.restrict_to_create_sale_order_group"></field>
            </xpath>
        </field>
    </record>
</odoo>
