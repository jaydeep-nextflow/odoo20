<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="nf_bag_charges_from_pos.NfProductCategoryPopup">
    <Dialog title="'🛍️ Carry Bag Selection'" size="'xl'" t-on-close="onCancel">

        <div style="min-height:400px; max-height:62vh; overflow-y:auto;">
            <t t-if="this.props.templates.length === 0">
                <div class="d-flex align-items-center justify-content-center p-5 text-muted">
                    No products found in bag category.
                </div>
            </t>

            <div class="row g-3 p-3">
                <t t-foreach="this.props.templates" t-as="template" t-key="template.id">
                    <div class="col-6 col-sm-3 col-md-4 col-lg-2">
                        <div class="card h-100 shadow-sm position-relative"
                             t-att-class="this.getQty(template.id) > 0 ? 'border-primary border-2' : ''"
                             style="border-radius:12px; overflow:hidden; cursor:pointer;"
                             t-on-click="() => this.onClickProduct(template)">

                            <!-- qty badge -->
                            <t t-if="this.getQty(template.id) > 0">
                                <span class="position-absolute top-0 end-0 m-1 badge bg-primary rounded-pill"
                                      t-out="this.getQty(template.id)"/>
                            </t>

                            <!-- image -->
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height:120px;">
                                <img t-att-src="this.getImageUrl(template)"
                                     style="max-height:100%; max-width:100%;"
                                     t-att-alt="template.display_name"/>
                            </div>

                            <!-- name + price -->
                            <div class="card-body p-2 text-center">
                                <div class="fw-semibold small lh-sm mb-1"
                                     t-out="template.display_name"/>
                                <div class="text-success fw-bold small"
                                     t-out="template.list_price"/>
                            </div>

                            <!-- qty controls shown when qty > 0 -->
                            <t t-if="this.getQty(template.id) > 0">
                                <div class="card-footer bg-white border-top p-1"
                                     t-on-click.stop="">
                                    <div class="d-flex justify-content-center align-items-center gap-2">
                                        <button class="btn btn-sm btn-outline-danger px-2 py-0"
                                                t-on-click="() => this.changeQty(template.id, -1)">−</button>
                                        <span class="fw-bold" t-out="this.getQty(template.id)"/>
                                        <button class="btn btn-sm btn-outline-success px-2 py-0"
                                                t-on-click="() => this.changeQty(template.id, 1)">+</button>
                                    </div>
                                </div>
                            </t>

                        </div>
                    </div>
                </t>
            </div>
        </div>

        <t t-set-slot="footer">
            <div class="d-flex justify-content-between align-items-center w-100">
                <span class="text-muted small">
                    <t t-out="this.totalSelected"/> bag(s) selected
                </span>
                <div class="d-flex gap-2">
                    <button class="btn btn-secondary" t-on-click="onCancel">Cancel</button>
                    <button class="btn btn-primary"
                            t-att-disabled="this.totalSelected === 0"
                            t-on-click="this.onConfirm">
                        Add to Cart
                    </button>
                </div>
            </div>
        </t>

    </Dialog>
</t>
</templates>
