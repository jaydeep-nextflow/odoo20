<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <template id="z_reports_details">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="record">
                <t t-call="web.external_layout">
                    <div class="page" style="page-break-inside: avoid;">
                        <div class="container">
                            <h1 t-out="data['current_order']['company_name']" class="pb-3 border-bottom border-1"></h1>
                            <address class="mb-0" t-field="env.company.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}' />
                            <div class="border border-1 mt-3">
                                <h1 class="p-2 text-info text-center">Sales Summary</h1>
                            </div>

                            <div class="row mt-3">
                                <div class="col-6">
                                    <div>Report Date time:</div>
                                    <t t-if="data['current_order']['start_date']">
                                        <div>Start Date</div>
                                    </t>
                                    <t t-if="data['current_order']['end_date']">
                                        <div>End Date</div>
                                    </t>
                                </div>

                                <div class="col-6 text-end">
                                    <div t-out="data['current_order']['current_date']"></div>
                                    <t t-if="data['current_order']['start_date']">
                                        <div t-out="data['current_order']['start_date']"></div>
                                    </t>
                                    <t t-if="data['current_order']['end_date']">
                                        <div t-out="data['current_order']['end_date']"></div>
                                    </t>
                                </div>
                            </div>

                            <div class="mt-3">
                                <h5>
                                    <strong>Name: <span t-out="record.user_id.name"></span>
                                    </strong>
                                </h5>
                            </div>

                            <div class="row mt-3">
                                <div class="col-6">
                                    <div>Sales:</div>
                                    <div>Total:</div>
                                    <div>Tax:</div>
                                    <div>Discount:</div>
                                    <div>Gross Total:</div>
                                </div>
                                <div class="col-6 text-end">
                                    <div t-out="data['current_order']['sales']"></div>
                                    <div t-out="data['current_order']['sales']"></div>
                                    <div t-out="data['current_order']['all_taxes']"></div>
                                    <div t-out="data['current_order']['amount_discount']"></div>
                                    <div t-out="data['current_order']['sales']"></div>
                                </div>
                            </div>

                            <h5 class="text-center">Department Sales Payments</h5>

                            <div class="border-bottom border-secondary pb-3">
                                <t t-foreach="data['payment_methods'].items()" t-as="payment">
                                    <div class="d-flex justify-content-between">
                                        <span t-out="payment[1]['payment_type']"></span>
                                        <span t-out="payment[1]['amount_payment']"></span>
                                    </div>
                                </t>
                            </div>

                            <div class="mt-3">
                                <h5 class="text-center">Department Sales Products</h5>
                            </div>


                            <div class="border-bottom border-secondary pb-4 mt-3">
                                <div class="row justify-content-between">
                                    <div class="col-5">
                                        Product Name
                                    </div>
                                    <div class="col-5">
                                        Product Quantity
                                    </div>
                                    <div class="col-2">
                                        Product Amount
                                    </div>
                                </div>


                                <div class="mt-3">
                                    <t t-foreach="data['product_details'].items()" t-as="product">
                                        <div class="row justify-content-between">
                                            <div class="col-5" t-out="product[1]['product_name']"></div>
                                            <div class="col-5" t-out="product[1]['product_quantity']"></div>
                                            <div class="col-2" t-out="product[1]['product_amount']"></div>
                                        </div>
                                    </t>
                                </div>
                            </div>


                            <div class="pt-5">
                                <h4 class="text-center">Summary</h4>
                                <div class="row">
                                    <div class="col-6">
                                        <div>Sales without Tax:</div>
                                        <div>Discount:</div>
                                        <div>Tax Amount:</div>
                                        <div>Gross Total:</div>
                                    </div>
                                    <div class="col-6 text-end">
                                        <div t-out="data['current_order']['sales_without_tax']"></div>
                                        <div t-out="data['current_order']['amount_discount']"></div>
                                        <div t-out="data['current_order']['all_taxes']"></div>
                                        <div t-out="data['current_order']['gross_total']"></div>
                                    </div>
                                </div>
                            </div>

                            <h5 class="text-center pb-3 border-bottom border-1">Department Sales</h5>


                            <div class="d-flex justify-content-center column-gap-2">
                                <div t-out="record.user_id.phone" class="pe-1"></div>
                                <div t-out="record.user_id.email"></div>
                            </div>

                            <div class="text-center">
                                <span t-out="data['current_order']['company_website']"></span>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="z_reports_details_menu" model="ir.actions.report">
        <field name="name">Pos Z Report</field>
        <field name="model">pos.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nf_pos_z_report.z_reports_details</field>
        <!-- <field name="report_file">nf_pos_z_report.z_reports_details</field> -->
        <field name="binding_type">report</field>
    </record>
</odoo>