<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_order_type_tree_view" model="ir.ui.view">
        <field name="name">pos.order.type.list</field>
        <field name="model">pos.order.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_delivery"/>
            </list>
        </field>
    </record>

    <record id="pos_order_type_form_view" model="ir.ui.view">
        <field name="name">pos.order.type.form</field>
        <field name="model">pos.order.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>

                        <group>
                            <field name="is_delivery"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_order_type_action" model="ir.actions.act_window">
        <field name="name">POS Order Types</field>
        <field name="res_model">pos.order.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_pos_order_type"
        name="Pos Order Types"
        parent="point_of_sale.menu_point_config_product"
        action="pos_order_type_action" sequence="41"/>
</odoo>
