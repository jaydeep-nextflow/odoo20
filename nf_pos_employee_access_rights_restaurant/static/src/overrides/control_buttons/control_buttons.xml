<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="nf_pos_employee_access_rights_restaurant.ControlButtons" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <!-- <xpath expr="//i[hasclass('fa-trash')]/.." position="attributes">
            <attribute name="t-if">pos.getCashier() and !pos.getCashier().nf_hide_cancel_order_button</attribute>
        </xpath> -->
        <xpath expr="//t[@icon=&quot;'content_copy'&quot;]" position="attributes">
            <attribute name="t-if">this.pos.getCashier() and !this.pos.getCashier().nf_hide_cancel_order_button</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click.stop='() => this.clickTransferOrder()']" position="attributes">
            <attribute name="t-if">this.pos.getCashier() and !this.pos.getCashier().nf_hide_merge_button</attribute>
        </xpath>
        <xpath expr="//t[@icon=&quot;'print'&quot;]" position="attributes">
            <attribute name="t-if">this.pos.getCashier() and !this.pos.getCashier().nf_hide_bill</attribute>
        </xpath>
        <xpath expr="//t[@icon=&quot;'person'&quot;]" position="attributes">
            <attribute name="t-if">this.pos.getCashier() and !this.pos.getCashier().nf_hide_guest_btn</attribute>
        </xpath>
    </t>

</templates>
