<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="nf_pos_employee_access_rights_restaurant.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('validation')]//button[hasclass('pay-order-button')]" position="attributes">
            <attribute name="t-if">this.pos.get_cashier() and !this.pos.get_cashier().nf_hide_payment_button and !this.swapButton</attribute>
        </xpath>

        <xpath expr="//button[@t-if='!currentOrder.is_empty()']" position="attributes">
            <attribute name="t-if">this.pos.get_cashier() and !this.pos.get_cashier().nf_hide_payment_button</attribute>
        </xpath>
    </t>

</templates>
