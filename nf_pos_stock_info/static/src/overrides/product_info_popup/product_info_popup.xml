<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">
    <t t-name="nfProductInfoPopup" t-inherit="point_of_sale.ProductInfoPopup" t-inherit-mode="extension">
        <xpath expr="//Dialog//div[hasclass('section-inventory')]" position="inside">
            <div class="mt-2">
                <table class="table-borderless sh-stock-info-table">
                    <thead>
                        <th>Name</th>
                        <th>On Hand</th>
                        <th>Available Quantity</th>
                    </thead>
                    <tbody>
                        <t t-foreach="props.info.productInfo.warehouses" t-as="warehouse" t-key="warehouse.name">
                            <tr>
                                <t t-if='warehouse.free_qty > 0 or warehouse.available_quantity > 0'>
                                    <td><t t-out="warehouse.location_id" class="table-name"/></td>
                                </t>
                                <t t-if='warehouse.free_qty > 0'>
                                    <td><t t-out="warehouse.free_qty" class="table-name"/></td>
                                </t>
                                <t t-if='warehouse.available_quantity > 0'>
                                    <td><t t-out="warehouse.available_quantity" class="table-name"/></td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </xpath>
    </t>
</templates>
