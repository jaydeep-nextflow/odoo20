<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">

    <record id="payment_provider_thawani" model="payment.provider">
        <field name="name">Thawani</field>
        <field name="code">thawani</field>
        <field name="image_128" type="bytes" file="nf_payment_thawani/static/description/icon.png"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="primary_payment_method_ids" eval="[(4, ref('payment_authorize.payment_method_card'))]"/>
        <field name="module_id" ref="base.module_nf_payment_thawani"/>
    </record>

    <record id="payment_method_thawani" model="payment.method">
        <field name="name">Thawani</field>
        <field name="code">Thawani</field>
        <field name="sequence">1</field>
        <field name="image" type="bytes" file="nf_payment_thawani/static/description/icon.png"/>
        <field name="support_tokenization">True</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">partial</field>
        <field name="provider_id" ref="payment_provider_thawani"/>
    </record>
</odoo>
