<?xml version='1.0' encoding='utf-8' ?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Thawani Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group name="thawani_credentials" invisible="code != 'thawani'">
                    <field name="thawani_api_secret_key" string="Secret API Key"
                           required="code == 'thawani' and is_live" password="True"/>
                    <field name="thawani_publishable_key" string="Publishable Key"
                           required="code == 'thawani' and is_live"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
