<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_pos_fantastic_dashboard_dashboard" model="ir.ui.view">
        <field name="name">fantastic.dashboard.view.list</field>
        <field name="model">nf.pos.dashboard</field>
        <!-- <field name="type">kanban</field> -->
        <field name="arch" type="xml">
            <list create="false" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="nf_view_nf_pos_dashboard_form" model="ir.ui.view">
        <field name="name">nf.pos.dashboard.form</field>
        <field name="model">nf.pos.dashboard</field>
        <field name="arch" type="xml">
            <form string="POS Dashboard">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="nf_view_nf_pos_dashboard_tree" model="ir.ui.view">
        <field name="name">nf.pos.dashboard.tree</field>
        <field name="model">nf.pos.dashboard</field>
        <field name="arch" type="xml">
            <list string="POS Dashboards">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="nf_pos_dashboard_design_action" model="ir.actions.act_window">
        <field name="name">POS Dashboard</field>
        <field name="res_model">nf.pos.dashboard</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="view_id" ref="nf_pos_fantastic_dashboard" /> -->
    </record>

    <record id="nf_pos_fantastic_dashboard_action_1" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="path">nf_fantastic_dashboards</field>
        <field name="tag">nf_pos_dashboard_template</field>
    </record>

    <menuitem id="main_dashboard1" action="nf_pos_dashboard.nf_pos_fantastic_dashboard_action_1" name="Pos Dashboard" parent="point_of_sale.menu_point_root" />
</odoo> 