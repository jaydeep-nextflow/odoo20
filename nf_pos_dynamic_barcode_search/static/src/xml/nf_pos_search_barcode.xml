<?xml version="1.0" encoding="UTF-8"?>
<templates id='template' xml:space='preserve'>
    <t t-extend='ProductItem' t-inherit='point_of_sale.ProductItem' t-inherit-mode='extension'>
        <xpath expr="//span[hasclass('price-tag')]" position="before">
            <t t-if="env.pos.dynamic_barcode_searched_code and env.pos.config._nf_enable_dynamic_barcode_search">
                <span class="nf-pos-dynamic-qty price-tag" title="Quantity"> <t t-esc="env.pos.dynamic_barcode_searched_code.value" /> </span>
            </t>
        </xpath>
    </t>
</templates>  