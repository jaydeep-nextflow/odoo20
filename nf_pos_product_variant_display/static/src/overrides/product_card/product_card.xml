<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="nf_pos_product_variant_display.ProductCard"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">

        <xpath expr="//div[hasclass('product-name')]" position="after">
            <div t-if="resolvedCategoryName"
                 class="nf-product-category-name overflow-hidden text-truncate">
                <span t-out="resolvedCategoryName"/>
            </div>
        </xpath>
    </t>
</templates>
