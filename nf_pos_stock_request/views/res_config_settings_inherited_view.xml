        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name='arch' type='xml'>
            <block id='pos_inventory_section' position='inside'>
                <setting id="nf_stock_request_config" help="Request the Internal Stock Transfer">
                    <field name='nf_enable_stock_request' />
                </setting>
            </block>
        </field>
    </record>

</odoo>