<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id='nf_pos_restrict_out_of_stok_order' model='ir.ui.view'>
        <field name='name'>nf.pos.restrict.out.stock.config.view.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name='arch' type='xml'>
            <setting id='nf_stock_info_config' position='inside'>
                <div class="row content-group" invisible="not nf_pos_enable_stock_info">
                    <setting invisible="not nf_pos_enable_stock_info" class="col-lg-12" >
                        <field name='_nf_pos_enable_stock_restriction' />
                    </setting>
                    <setting invisible="not _nf_pos_enable_stock_restriction" class="col-lg-12" >
                        <field name='_nf_to_sale_morthan_on_hand' />
                    </setting>
                </div>
            </setting>
        </field>
    </record>
</odoo>