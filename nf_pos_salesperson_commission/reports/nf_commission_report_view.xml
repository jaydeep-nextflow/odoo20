<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <template id="nf_commission_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-if="orders[-1].get('employee_name')" class="align-bottom p-0 ps-2">
                        <h2 class="layout_document_title o_folder_title mt-2 text-nowrap" t-out="orders[-1].get('employee_name')"></h2>
                    </t>

                    <div id="informations" class="row mb-4">
                        <div class="col" name="start_date">
                            <strong>Start Date</strong>
                            <div t-out="orders[-1].get('date_start')"></div>
                        </div>

                        <div class="col" name="end_date">
                            <strong>End Date</strong>
                            <div t-out="orders[-1].get('date_stop')"></div>
                        </div>
                    </div>

                    <table class="table" name="commission_line_table" style="border:3px solid #ccc">
                        <tr >
                            <th style="border:3px solid #ccc" name="th_order" class="text-start ps-2 text-uppercase nf_pos_commission_th">
                                <span>Description</span>
                            </th>
                            <th style="border:3px solid #ccc" name="th_date" class="text-end text-uppercase nf_pos_commission_th">
                                <span>Quantity</span>
                            </th>
                            <th style="border:3px solid #ccc" name="th_state" class="text-end text-uppercase d-md-table-cell nf_pos_commission_th">
                                <span>State</span>
                            </th>
                            <th style="border:3px solid #ccc" name="th_subtotal" class="text-end text-uppercase pe-2 nf_pos_commission_th">
                                <span>Amount</span>
                            </th>
                        </tr>

                        <tr t-foreach="orders" t-as="commission">
                            <t t-if="commission.get('commission_amount')">
                                <td style="border:1px solid #ccc" name="account_invoice_line_name" class="ps-2">
                                    <span t-out="commission.get('order_name')"></span>
                                </td>
                                <td style="border:1px solid #ccc" class="text-end">
                                    <span t-out="commission.get('date_order')"></span>
                                </td>
                                <td style="border:1px solid #ccc" class="text-end d-md-table-cell text-capitalize">
                                    <span t-out="commission.get('state')"></span>
                                </td>
                                <td style="border:1px solid #ccc;background-color:#f9fafb;" class="text-end pe-2">
                                    <span class="oe_currency_value" t-out="commission.get('commission_amount')"></span>
                                </td>
                            </t>
                        </tr>
                    </table>

                    <div class="row justify-content-end mt-n3">
                        <div style="width:43.7%;">
                            <table class="table" style="border:3px solid #ccc">
                                <t t-if="orders[-1].get('draft_amount')">
                                    <tr style="background-color:#f9fafb;">
                                        <t t-if="orders[-1].get('draft_amount')"></t>
                                        <td class="fw-bold ps-2" style="width:54%;border:1px solid #ccc;">
                                            <strong>Draft Amount</strong>
                                        </td>
                                        <td class="text-end fw-bold pe-2">
                                            <span t-out="orders[-1].get('draft_amount')"></span>
                                        </td>
                                    </tr>
                                </t>

                                <t t-if="orders[-1].get('confirm_amount')">
                                    <tr style="background-color:#f9fafb;">
                                        <td class="fw-bold ps-2" style="width:54%;border:1px solid #ccc;">
                                            <strong>Confirm Amount</strong>
                                        </td>
                                        <td style="border:1px solid #ccc;" class="text-end fw-bold pe-2">
                                            <span t-out="orders[-1].get('confirm_amount')"></span>
                                        </td>
                                    </tr>
                                </t>

                                <t t-if="orders[-1].get('paid_amount')">
                                    <tr style="background-color:#f9fafb;">
                                        <td class="fw-bold ps-2" style="width:54%;border:1px solid #ccc;">
                                            <strong>Paid Amount</strong>
                                        </td>
                                        <td style="border:1px solid #ccc;" class="text-end fw-bold pe-2">
                                            <span t-out="orders[-1].get('paid_amount')"></span>
                                        </td>
                                    </tr>
                                </t>

                                <t t-if="orders[-1].get('cancel_amount')">
                                    <tr style="background-color:#f9fafb;">
                                        <td class="fw-bold ps-2" style="width:54%;border:1px solid #ccc;">
                                            <strong>Cancel Amount</strong>
                                        </td>
                                        <td style="border:1px solid #ccc;" class="text-end fw-bold pe-2">
                                            <span t-out="orders[-1].get('cancel_amount')"></span>
                                        </td>
                                    </tr>
                                </t>

                                <tr class="bg-primary">
                                    <td class="fw-bold ps-2" style="width:54%;border:1px solid #ccc;">
                                        <strong style="color:white;">Total Amount</strong>
                                    </td>
                                    <td style="border:1px solid #ccc;" class="text-end fw-bold pe-2">
                                        <span style="color:white;" t-out="orders[-1].get('total_commission')"></span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="nf_commission_report_action" model="ir.actions.report">
        <field name="name">SalesPerson Commission Report</field>
        <field name="model">nf.commission.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nf_pos_salesperson_commission.nf_commission_report</field>
        <field name="report_file">nf_pos_salesperson_commission.nf_commission_report</field>
        <field name="binding_type">report</field>
    </record>

</odoo>