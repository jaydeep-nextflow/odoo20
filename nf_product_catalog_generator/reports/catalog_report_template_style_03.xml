<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_product_catalog_style3_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context()"/>
            <div class="page" id="style3_design">
                <style>
                #style3_design {
                    background-color: #fdf6f0;
                    font-family: Georgia, serif;
                }

                #style3_design h3 {
                    text-align: center;
                    font-size: 22px;
                    font-weight: bold;
                    letter-spacing: 2px;
                    text-transform: uppercase;
                    color: #3a3a3a;
                    margin-bottom: 24px;
                }

                #style3_design .product-row {
                    display: table;
                    width: 100%;
                    margin-bottom: 16px;
                    background: #fff;
                    border-radius: 12px;
                    overflow: hidden;
                    page-break-inside: avoid;
                }

                #style3_design .product-row-inner {
                    display: table-row;
                }

                #style3_design .product-image-cell {
                    display: table-cell;
                    width: 38%;
                    vertical-align: middle;
                    padding: 16px;
                    background: #f5ede8;
                }

                #style3_design .image-blob {
                    width: 100%;
                    height: 160px;
                    border-radius: 50% 40% 50% 40%;
                    overflow: hidden;
                    background: #fff;
                    display: table;
                    margin: 0 auto;
                }

                #style3_design .image-blob span,
                #style3_design .image-blob img {
                    width: 100% !important;
                    height: 160px !important;
                    object-fit: contain;
                    display: block;
                }

                #style3_design .product-content-cell {
                    display: table-cell;
                    width: 62%;
                    vertical-align: middle;
                    padding: 20px 24px;
                }

                #style3_design .product-name {
                    font-size: 18px;
                    font-weight: bold;
                    color: #2d2d2d;
                    margin-bottom: 6px;
                    letter-spacing: 1px;
                }

                #style3_design .product-meta {
                    font-size: 11px;
                    color: #999;
                    margin-bottom: 10px;
                    letter-spacing: 0.5px;
                }

                #style3_design .product-meta span {
                    margin-right: 8px;
                }

                #style3_design .product-description {
                    font-size: 12px;
                    color: #666;
                    line-height: 1.7;
                    margin-bottom: 14px;
                }

                #style3_design .price-badge {
                    display: inline-block;
                    background: #008080;
                    color: #fff;
                    font-size: 13px;
                    font-weight: bold;
                    padding: 6px 18px;
                    border-radius: 20px;
                    letter-spacing: 1px;
                }

                #style3_design .no-image-blob {
                    width: 140px;
                    height: 140px;
                    border-radius: 50% 40% 50% 40%;
                    background: #e8ddd7;
                    display: table-cell;
                    vertical-align: middle;
                    text-align: center;
                    color: #bbb;
                    font-size: 11px;
                    margin: 0 auto;
                }

                #style3_design .decor-circle {
                    position: absolute;
                    border-radius: 50%;
                    opacity: 0.15;
                }
                </style>

                <h2>
                    <span t-field="o.catalog_name"/>
                </h2>

                <t t-set="products" t-value="o.product_id"/>
                <t t-set="total" t-value="len(products)"/>

                <t t-foreach="range(total)" t-as="idx">
                    <t t-set="line" t-value="products[idx]"/>

                    <!-- Page break if enabled -->
                    <t t-if="o.break_page and o.break_after_product and o.break_after_product > 0 and idx > 0 and (idx % o.break_after_product) == 0">
                        <div style="page-break-before: always;"/>
                    </t>

                    <!-- Always image LEFT, content RIGHT -->
                    <div class="product-row">
                        <div class="product-row-inner">

                            <!-- Image Cell — always left -->
                            <div class="product-image-cell">
                                <t t-if="o.image and line.image_1920">
                                    <div class="image-blob">
                                        <span t-field="line.image_1920" t-attf-style="width:{{ o.image_width or 140 }}px; height:{{ o.image_height or 140 }}px; object-fit:contain;" t-options="{'widget': 'image'}"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="no-image-blob">No Image</div>
                                </t>
                            </div>

                            <!-- Content Cell — always right -->
                            <div class="product-content-cell">

                                <!-- Product Name -->
                                <div class="product-name">
                                    <t t-if="o.product_link">
                                        <a t-attf-href="/web#id={{ line.id }}&amp;model=product.product&amp;view_type=form" style="color:#2d2d2d; text-decoration:none;">
                                            <span t-out="line.display_name"/>
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <span t-out="line.display_name"/>
                                    </t>
                                </div>

                                <!-- Meta: Internal Ref + Category + UOM -->
                                <div class="product-meta">
                                    <t t-if="o.inter_ref">
                                        <span t-out="line.default_code or ''"/>
                                    </t>
                                    <t t-if="o.print_category">
                                        <span t-out="line.categ_id.name or ''"/>
                                    </t>
                                    <t t-if="o.print_uom">
                                        <span t-out="line.uom_id.name or ''"/>
                                    </t>
                                </div>

                                <!-- Description -->
                                <t t-if="o.description">
                                    <div class="product-description">
                                        <span t-out="line.description or ''"/>
                                    </div>
                                </t>

                                <!-- Price -->
                                <t t-if="o.price">
                                    <div class="price-badge">
                                        <span t-field="line.lst_price" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </div>
                                </t>

                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <!-- Main wrapper -->
    <template id="report_product_catalog_style3">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="nf_product_catalog_generator.report_product_catalog_style3_document"/>
            </t>
        </t>
    </template>
</odoo>
