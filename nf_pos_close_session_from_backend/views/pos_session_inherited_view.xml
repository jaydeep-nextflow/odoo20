<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nf_view_pos_session_inherited_form_view" model="ir.ui.view">
        <field name="name">pos.session.inherited.form.view</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" postion="inside">
                <button name="action_nf_pos_session_closing_control" type="object" string="Close Pos Session" class="oe_highlight" invisible="state != 'opened' or state == 'closed' and state != 'opening_control'"/>
            </xpath>
        </field>
    </record>
</odoo>