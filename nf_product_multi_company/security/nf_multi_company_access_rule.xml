<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_nf_product_multi_company">
           <field name="name">Product Multi Company Access</field>
           <field name="sequence">5</field>
       </record>
       <record id="nf_product_multi_company_privilege" model="res.groups.privilege">
           <field name="name">Product Multi Company</field>
           <field name="category_id" ref="nf_product_multi_company.module_category_nf_product_multi_company"></field>
        </record>
        
        <record id="nf_product_multi_company_user" model="res.groups">
            <field name="name">Multi Company User</field>
            <field name="privilege_id" ref="nf_product_multi_company_privilege"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="nf_product_multi_company_manager" model="res.groups">
            <field name="name">Multi Company Manager</field>
            <field name="privilege_id" ref="nf_product_multi_company_privilege"></field>
            <field name="implied_ids" eval="[(4,ref('nf_product_multi_company_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
        </record>
    </data>
</odoo>