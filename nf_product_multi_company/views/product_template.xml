<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_product_template_form_view" model="ir.ui.view">
        <field name="name">nf.product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='general_information']/group/group[@name='group_standard_price']/field[@name='company_id']" position="attributes">
                 <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='general_information']/group/group[@name='group_standard_price']" position="inside">
                <field name="nf_is_multi_company_manager" invisible="1"></field>
                <field name="nf_company_ids" widget="many2many_tags" invisible="not nf_is_multi_company_manager"/>
            </xpath>
            
        </field>
    </record>
</odoo>