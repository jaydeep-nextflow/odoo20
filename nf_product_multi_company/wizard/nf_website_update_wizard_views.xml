<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nf_website_update_wizard_form" model="ir.ui.view">
        <field name="name">nf.website.update.wizard.form</field>
        <field name="model">nf.website.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Websites">
                <group>
                    <field name="nf_company_ids" widget="many2many_tags" />
                </group>
                <footer>
                    <button string="Update" type="object" name="action_update_websites" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
